# ---------------------------------------------------------------------------
# Voting System environment template.
# Copy to `.env` (git-ignored) and fill in real values.  Every variable has a
# safe development default EXCEPT in the `production` profile, which refuses
# to start when required secrets are missing (fail-fast, see
# config/settings/production.py).
# ---------------------------------------------------------------------------

# Profile: local | production | test   (selects config/settings/<profile>.py)
DJANGO_ENV=local

# --- Core Django security ----------------------------------------------------
# Generate: python -c "from django.core.management.utils import \
#   get_random_secret_key; print(get_random_secret_key())"
# production: FATAL if missing or still the insecure dev default.
DJANGO_SECRET_KEY=change-me

# Comma-separated host names. production: FATAL if empty.
DJANGO_ALLOWED_HOSTS=voting.example.org,localhost

# Required when serving over HTTPS behind a proxy (exact origin match).
# e.g. https://voting.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=

# Defaults: DEBUG on in local, always off in production.
DJANGO_DEBUG=false

# HTTPS enforcement (production defaults: SSL redirect ON, HSTS 1 year).
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000

# --- Database ----------------------------------------------------------------
# local default: sqlite (file: db.sqlite3).  production: postgresql (FATAL
# if anything else).
DB_ENGINE=postgresql
DB_NAME=voting
DB_USER=voting
DB_PASSWORD=
# docker-compose only: password for the bundled postgres service (web/worker
# read it from here via ${POSTGRES_PASSWORD} interpolation).
POSTGRES_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10

# --- Cache / broker ----------------------------------------------------------
# Multi-process-safe rate limiting + caching.  Strongly recommended with
# gunicorn (more than one worker).  Empty = in-process LocMem fallback.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=votesys

# Celery.  Ballot acceptance NEVER depends on Celery; there are currently no
# background tasks (scaffolding only).  production: FATAL if no broker and
# CELERY_TASK_ALWAYS_EAGER is not set.
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# --- Cryptographic material (NEVER commit real values) -----------------------
# Ballot encryption at rest (Fernet key, base64, 32-byte key material).
# Generate: python -c "from cryptography.fernet import Fernet; \
#   print(Fernet.generate_key().decode())"
# production: FATAL unless this is set or BALLOT_KEY_FILE exists.
BALLOT_ENCRYPTION_KEY=
BALLOT_KEY_FILE=

# Result/audit signature key.  Preferred: PEM Ed25519 private key.
# Generate: openssl genpkey -algorithm ed25519 -out result_signing.key
# (A raw string value instead of a PEM switches signatures to HMAC-SHA256,
# which only the server can verify - avoid in production.)
RESULT_SIGNING_KEY=
RESULT_SIGNING_KEY_FILE=

# Pepper for hashing voter credentials (peppered HMAC).  Rotating it
# invalidates every unexpired voter credential - see docs/OPERATIONS.md.
VOTER_TOKEN_PEPPER=

# --- Admin / back-office branding (django-jazzmin) ---------------------------
# The back office at /watch/ is themed with django-jazzmin.  BRAND_NAME is the
# product name shown in the sidebar/brand, the sign-in page and page titles;
# the JAZZMIN_* variables override individual strings (all optional).
BRAND_NAME=VoteSys
#JAZZMIN_SITE_TITLE=VoteSys back office
#JAZZMIN_SITE_HEADER=VoteSys
#JAZZMIN_SITE_BRAND=VoteSys

# --- Workstation appearance --------------------------------------------------
# Backdrop picture behind the verification console.  Use a path relative to
# static/ or an absolute URL/path; any image format works.  The bundled
# default (img/workstation-background.svg) is used when this is unset.
#VERIFICATION_BACKGROUND_IMAGE=img/station.jpg

# --- Authority / oversight ---------------------------------------------------
# Explicit system-wide oversight grant for named election-commission chairs
# (comma-separated usernames).  Each named chair gains election and people
# oversight across every tenant, but NOT organization lifecycle administration
# (creating/renaming/toggling tenants), which stays with the Super Admin.
# Leave empty to rely on per-organization memberships only.
EC_CHAIR_SYSTEM_SCOPE_USERNAMES=

# --- Operational tuning ------------------------------------------------------
SESSION_COOKIE_AGE=14400
# Rate limits.  Only the ballot-page / cast-POST throttles are wired up
# today (hardcoded 30/min and 10/min in ballot/views.py); the voter-login
# and report-download settings are defined but unused.
RATE_LIMIT_WINDOW=60
RATE_LIMIT_VOTER_LOGIN=8
RATE_LIMIT_BALLOT_CAST=12
RATE_LIMIT_REPORT_DOWNLOAD=30
DATA_UPLOAD_MAX_MEMORY_SIZE=12582912
FILE_UPLOAD_MAX_MEMORY_SIZE=12582912

# --- Candidate passport photographs ------------------------------------------
# Maximum size of a single photograph upload (JPEG/PNG/WebP, validated
# server-side).  Stored under MEDIA_ROOT (./media; the `media` volume in
# docker-compose.yml — back it up with the database).
CANDIDATE_PHOTO_MAX_UPLOAD_MB=5
# Whether Django serves /media/ itself.  Defaults to DEBUG; the docker-compose
# stack sets it to true.  In production put nginx in front, serve /media/ from
# the media volume and set this to false (docs/DEPLOY_ONLINE.md).
SERVE_MEDIA=true

DJANGO_LOG_LEVEL=INFO
DJANGO_LANGUAGE_CODE=en-us
DJANGO_TIME_ZONE=UTC

# --- Test profile only -------------------------------------------------------
# Keep the on-disk test database between `manage.py test` runs.
#TEST_KEEP_DB=1
